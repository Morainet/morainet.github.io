---
// 单篇教程视图:/projects/<slug>/tutorials/<name>/ 与 /en/ 同构页面共用。
// 文档式布局:左侧为该项目教程目录(当前篇高亮),右侧为正文;上/下篇在同一集合内轮转。
import { render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { link, relToRoot } from '../../lib/rel'
import { pathFor } from '../../lib/i18n'
import { t, type Locale } from '../../i18n/ui'

interface Props {
  locale: Locale
  project: import('astro:content').CollectionEntry<'projects'>
  tutorial: import('astro:content').CollectionEntry<'tutorials'>
  /** 该项目全部教程(已按 order 排序),用于左侧目录 */
  tutorials: import('astro:content').CollectionEntry<'tutorials'>[]
  prev: import('astro:content').CollectionEntry<'tutorials'> | null
  next: import('astro:content').CollectionEntry<'tutorials'> | null
}

const { locale, project, tutorial, tutorials, prev, next } = Astro.props
const i = t(locale)
const { Content } = await render(tutorial)
const rel = relToRoot(Astro.url.pathname)
const listHref = link(rel, pathFor(locale, `projects/${project.id}/tutorials/`))
const projectHref = link(rel, pathFor(locale, `projects/${project.id}/`))
const tutorialHref = (x) =>
  link(rel, pathFor(locale, `projects/${project.id}/tutorials/${x.id.split('/').slice(1).join('/')}/`))
---
<Base
  title={`${tutorial.data.title} · ${project.data.title} ${i['tutorials.title']}`}
  description={tutorial.data.description ?? `${project.data.title} ${i['tutorials.title']}:${tutorial.data.title}`}
>
  <section class="section project-detail tutorial-detail">
    <div class="tutorial-layout">
      <aside class="tutorial-sidebar">
        <p class="toc-title">{project.data.title} <span>· {i['tutorials.title']}</span></p>
        <ol class="toc">
          {
            tutorials.map((x, idx) => (
              <li>
                <a
                  href={tutorialHref(x)}
                  class:list={[{ active: x.id === tutorial.id }]}
                  aria-current={x.id === tutorial.id ? 'location' : undefined}
                >
                  <span class="toc-num">{String(idx + 1).padStart(2, '0')}</span>
                  <span>{x.data.title}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <a class="toc-back" href={projectHref}>← {project.data.title} {i['tutorials.backToProject']}</a>
      </aside>

      <div class="tutorial-main">
        <header class="project-hero">
          <p class="kicker">{i['tutorials.kickerSuffix']}</p>
          <h1>{tutorial.data.title}</h1>
          {tutorial.data.description && <p class="project-desc">{tutorial.data.description}</p>}
        </header>

        <div class="content" data-reveal>
          <Content />
        </div>

        {
          (prev || next) && (
            <nav class="proj-nav" data-reveal>
              {prev ? (
                <a href={tutorialHref(prev)} class="proj-nav-item prev">
                  <span class="proj-nav-label">{i['tutorial.prev']}</span>
                  <span class="proj-nav-title">{prev.data.title}</span>
                </a>
              ) : (
                <span />
              )}
              {next ? (
                <a href={tutorialHref(next)} class="proj-nav-item next">
                  <span class="proj-nav-label">{i['tutorial.next']}</span>
                  <span class="proj-nav-title">{next.data.title}</span>
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }

        <p class="back">
          <a href={listHref}>{i['tutorial.allTutorials']}</a>
          <span aria-hidden="true"> · </span>
          <a href={projectHref}>{project.data.title} {i['tutorials.backToProject']}</a>
        </p>
      </div>
    </div>
  </section>
</Base>
