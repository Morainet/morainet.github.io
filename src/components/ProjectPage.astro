---
// 项目详情宣传页视图:整站 /projects/<slug>/、/en/projects/<slug>/ 与单项目独立站首页共用。
// 结构:Hero(标语 + CTA)→ 核心特性网格 → 技术栈 → 正文 → 底部 CTA → 上/下篇。
// 正文 Markdown 通过 <slot /> 传入。
import type { CollectionEntry } from 'astro:content'
import { relToRoot, link } from '../lib/rel'
import { pathFor } from '../lib/i18n'
import { t, type Locale } from '../i18n/ui'

interface Props {
  project: CollectionEntry<'projects'>
  /** 完整站点时的全部项目,用于上/下篇导航 */
  all: CollectionEntry<'projects'>[]
  /** 单项目独立部署:隐藏上/下篇与返回列表 */
  standalone?: boolean
  locale?: Locale
}

const { project, all, standalone = false, locale = 'zh' } = Astro.props
const i = t(locale)
const meta = project.data
const rel = relToRoot(Astro.url.pathname)
const homeHref = link(rel, pathFor(locale, ''))
const sorted = [...all].sort((a, b) => a.data.order - b.data.order)
const index = sorted.findIndex((p) => p.id === project.id)
const prev = !standalone && index > 0 ? sorted[index - 1] : null
const next = !standalone && index < sorted.length - 1 ? sorted[index + 1] : null
// 状态枚举值固定为中文,展示时按语言映射
const statusLabel = i[`status.${meta.status}` as const] ?? meta.status
---
<section class="section project-detail">
  <header class="project-hero">
    <p class="kicker">{i['project.kicker']}</p>
    <div class="project-head">
      {
        meta.logo ? (
          <img
            class="project-logo"
            src={meta.logo.src}
            width={meta.logo.width}
            height={meta.logo.height}
            alt={`${meta.title} logo`}
          />
        ) : (
          <div class="project-icon">{meta.icon}</div>
        )
      }
      <div>
        <h1>{meta.title}</h1>
        <p class="card-tagline">{meta.tagline}</p>
      </div>
    </div>
    <p class="project-desc">{meta.description}</p>
    <div class="project-meta">
      <span class={`status status-${meta.status}`}>{statusLabel}</span>
      <a class="btn-outline" href={link(rel, pathFor(locale, `projects/${project.id}/tutorials/`))}>{i['project.tutorials']}</a>
      {meta.repo && <a class="btn-outline" href={meta.repo} target="_blank" rel="noopener">{i['project.repo']} ↗</a>}
      {meta.demo && <a class="btn-outline" href={meta.demo} target="_blank" rel="noopener">{i['project.demo']} ↗</a>}
    </div>
  </header>

  {
    meta.highlights.length > 0 && (
      <section class="block" data-reveal>
        <h2>{i['project.highlights']}</h2>
        <ol class="feature-grid">
          {meta.highlights.map((h, idx) => (
            <li class="feature-item">
              <span class="feature-num">{String(idx + 1).padStart(2, '0')}</span>
              <span>{h}</span>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    meta.tech.length > 0 && (
      <section class="block" data-reveal>
        <h2>{i['project.tech']}</h2>
        <div class="tech-badges">
          {meta.tech.map((x) => (
            <span class="tech-badge">{x}</span>
          ))}
        </div>
      </section>
    )
  }

  <div class="content" data-reveal>
    <slot />
  </div>

  <aside class="cta-band" data-reveal>
    <p class="cta-title">{i['project.ctaTitle']}</p>
    <div class="cta-actions">
      {meta.repo && <a class="btn btn-sm" href={meta.repo} target="_blank" rel="noopener">{i['project.repo']} ↗</a>}
      {meta.demo && <a class="btn-outline" href={meta.demo} target="_blank" rel="noopener">{i['project.demo']} ↗</a>}
    </div>
  </aside>

  {
    (prev || next) && (
      <nav class="proj-nav" data-reveal>
        {prev ? (
          <a href={link(rel, pathFor(locale, `projects/${prev.id}/`))} class="proj-nav-item prev">
            <span class="proj-nav-label">{i['project.prev']}</span>
            <span class="proj-nav-title">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a href={link(rel, pathFor(locale, `projects/${next.id}/`))} class="proj-nav-item next">
            <span class="proj-nav-label">{i['project.next']}</span>
            <span class="proj-nav-title">{next.data.title}</span>
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }

  {!standalone && (
    <p class="back">
      <a href={homeHref}>{i['project.backToList']}</a>
    </p>
  )}
</section>
