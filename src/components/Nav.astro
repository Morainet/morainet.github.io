---
// 顶部导航。standalone 模式(单项目独立部署)下只保留本项目入口与外链。
import { MAIN_SITE_URL, GITHUB_ORG_URL } from '../config'

interface Props {
  standalone?: boolean
}
const { standalone = false } = Astro.props
const isHome = Astro.url.pathname === '/'
---
<header class="site-header">
  <nav class="nav container">
    <a href="/" class="brand">Morainet</a>
    <ul class="nav-links">
      <li>
        {
          standalone ? (
            <a href="/">项目介绍</a>
          ) : (
            <a href="/" class={isHome ? 'active' : undefined} aria-current={isHome ? 'page' : undefined}>
              首页
            </a>
          )
        }
      </li>
      <li><a href={MAIN_SITE_URL} target="_blank" rel="noopener">主站 ↗</a></li>
      <li><a href={GITHUB_ORG_URL} target="_blank" rel="noopener">GitHub ↗</a></li>
      <li>
        <button class="theme-toggle" aria-label="切换深色/浅色模式">
          <span class="icon-moon">🌙</span><span class="icon-sun">☀️</span>
        </button>
      </li>
    </ul>
  </nav>
</header>

<script>
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.theme-toggle')
    if (!btn) return
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
    document.documentElement.dataset.theme = next
    localStorage.setItem('morainet-theme', next)
  })
</script>
