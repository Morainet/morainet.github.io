---
// 顶部导航。standalone 模式(单项目独立部署)下只保留本项目入口与外链。
import { MAIN_SITE_URL, GITHUB_ORG_URL } from '../config'
import { relToRoot, link } from '../lib/rel'

interface Props {
  standalone?: boolean
}
const { standalone = false } = Astro.props
const isHome = Astro.url.pathname === '/'
const rel = relToRoot(Astro.url.pathname)
const homeHref = link(rel, '')
---
<header class="site-header">
  <nav class="nav container">
    <a href={homeHref} class="brand">
      <svg width="22" height="22" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path d="M16 4 28 26H4L16 4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
        <path d="M9.5 17h13M7 21.5h18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
      <span>Morainet</span>
    </a>
    <ul class="nav-links">
      <li>
        {
          standalone ? (
            <a href={homeHref}>项目介绍</a>
          ) : (
            <a href={homeHref} class={isHome ? 'active' : undefined} aria-current={isHome ? 'page' : undefined}>
              首页
            </a>
          )
        }
      </li>
      <li><a href={MAIN_SITE_URL} target="_blank" rel="noopener">主站 ↗</a></li>
      <li><a href={GITHUB_ORG_URL} target="_blank" rel="noopener">GitHub ↗</a></li>
      <li>
        <button class="theme-toggle" aria-label="切换深色/浅色模式">
          <span class="icon-moon">🌙</span><span class="icon-sun">☀️</span>
        </button>
      </li>
    </ul>
  </nav>
</header>

<script>
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.theme-toggle')
    if (!btn) return
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
    document.documentElement.dataset.theme = next
    localStorage.setItem('morainet-theme', next)
  })
</script>
