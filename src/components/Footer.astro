---
import { MAIN_SITE_URL, GITHUB_ORG_URL } from '../config'
import { t, type Locale } from '../i18n/ui'

const locale = (Astro.currentLocale as Locale | undefined) ?? 'zh'
const i = t(locale)
const year = new Date().getFullYear()
---
<footer class="site-footer">
  <div class="container footer-inner">
    <p>© {year} Morainet. {i['footer.built']}</p>
    <p>
      <a href={MAIN_SITE_URL} target="_blank" rel="noopener">{i['footer.mainSite']} ↗</a>
      ·
      <a href={GITHUB_ORG_URL} target="_blank" rel="noopener">{i['footer.githubOrg']} ↗</a>
    </p>
  </div>
</footer>
