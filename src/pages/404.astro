---
import Base from '../layouts/Base.astro'
import { relToRoot, link } from '../lib/rel'

const rel = relToRoot(Astro.url.pathname)
---
<Base title="页面不存在">
  <section class="section notfound">
    <div class="notfound-code">404</div>
    <h1>页面走丢了</h1>
    <p class="empty">你访问的地址不存在，或该项目尚未公开。</p>
    <div class="notfound-actions">
      <a href={link(rel, '')} class="btn">回到首页</a>
      <a href={link(rel, 'projects/')} class="btn-outline">浏览项目</a>
    </div>
  </section>
</Base>
