---
// 单篇教程页(英文,/en/projects/<slug>/tutorials/<name>/)。
import { getProjects, getTutorials } from '../../../../../lib/i18n'
import TutorialView from '../../../../../components/views/TutorialView.astro'

export async function getStaticPaths() {
  // 单项目独立构建仅产出中文站,跳过英文页
  if (process.env.PROJECT_SLUG) return []
  const [all, tutorials] = await Promise.all([getProjects('en'), getTutorials('en')])
  return all.flatMap((project) => {
    const own = tutorials
      .filter((x) => x.id.startsWith(`${project.id}/`))
      .sort((a, b) => a.data.order - b.data.order)
    return own.map((tutorial, idx) => ({
      params: { slug: project.id, tutorial: tutorial.id.split('/').slice(1).join('/') },
      props: { project, tutorial, tutorials: own, prev: own[idx - 1] ?? null, next: own[idx + 1] ?? null },
    }))
  })
}

const { project, tutorial, tutorials, prev, next } = Astro.props
---
<TutorialView locale="en" project={project} tutorial={tutorial} tutorials={tutorials} prev={prev} next={next} />
