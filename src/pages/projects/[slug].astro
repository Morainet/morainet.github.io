---
// 项目详情页(中文,/projects/<slug>/)。
import { getProjects } from '../../lib/i18n'
import { onlyStandalone } from '../../lib/standalone'
import ProjectView from '../../components/views/ProjectView.astro'

export async function getStaticPaths() {
  const all = await getProjects('zh')
  return onlyStandalone(all).map((project) => ({ params: { slug: project.id }, props: { project, all } }))
}

const { project, all } = Astro.props
---
<ProjectView locale="zh" project={project} all={all} />
