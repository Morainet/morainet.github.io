---
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import ProjectPage from '../../components/ProjectPage.astro'
import { onlyStandalone } from '../../lib/standalone'

export async function getStaticPaths() {
  const all = await getCollection('projects')
  return onlyStandalone(all).map((project) => ({ params: { slug: project.id }, props: { project, all } }))
}

const { project, all } = Astro.props
const { Content } = await render(project)
---
<Base title={project.data.title} description={project.data.description}>
  <ProjectPage project={project} all={all}>
    <Content />
  </ProjectPage>
</Base>
