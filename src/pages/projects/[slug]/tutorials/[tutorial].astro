---
// 单篇教程页(中文,/projects/<slug>/tutorials/<name>/)。
import { getProjects, getTutorials } from '../../../../lib/i18n'
import { onlyStandalone } from '../../../../lib/standalone'
import TutorialView from '../../../../components/views/TutorialView.astro'

export async function getStaticPaths() {
  const [all, tutorials] = await Promise.all([getProjects('zh'), getTutorials('zh')])
  return onlyStandalone(all).flatMap((project) => {
    const own = tutorials
      .filter((x) => x.id.startsWith(`${project.id}/`))
      .sort((a, b) => a.data.order - b.data.order)
    return own.map((tutorial, idx) => ({
      params: { slug: project.id, tutorial: tutorial.id.split('/').slice(1).join('/') },
      props: { project, tutorial, prev: own[idx - 1] ?? null, next: own[idx + 1] ?? null },
    }))
  })
}

const { project, tutorial, prev, next } = Astro.props
---
<TutorialView locale="zh" project={project} tutorial={tutorial} prev={prev} next={next} />
