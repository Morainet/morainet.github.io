---
// 项目教程列表页:每个项目都预留 /projects/<slug>/tutorials/,
// 尚无教程时显示"整理中"占位。新增教程 = 在项目目录下
// src/content/projects/<slug>/tutorials/ 新建 .md,无需改动代码。
import { getCollection } from 'astro:content'
import Base from '../../../../layouts/Base.astro'
import { link, relToRoot } from '../../../../lib/rel'
import { onlyStandalone } from '../../../../lib/standalone'

export async function getStaticPaths() {
  const all = await getCollection('projects')
  const tutorials = await getCollection('tutorials')
  return onlyStandalone(all).map((project) => ({
    params: { slug: project.id },
    props: {
      project,
      tutorials: tutorials
        .filter((t) => t.id.startsWith(`${project.id}/`))
        .sort((a, b) => a.data.order - b.data.order),
    },
  }))
}

const { project, tutorials } = Astro.props
const rel = relToRoot(Astro.url.pathname)
const projectHref = link(rel, `projects/${project.id}/`)
const tutorialHref = (t) => {
  const name = t.id.split('/').slice(1).join('/')
  return link(rel, `projects/${project.id}/tutorials/${name}/`)
}
---
<Base title={`${project.data.title} 教程`} description={`${project.data.title} 的入门指南与实战教程。`}>
  <section class="section project-detail">
    <header class="project-hero">
      <p class="kicker">{project.data.title} · 教程</p>
      <h1>教程</h1>
      <p class="project-desc">{project.data.title} 的入门指南与实战教程。</p>
    </header>

    {
      tutorials.length > 0 ? (
        <ol class="tutorial-list">
          {tutorials.map((t) => (
            <li class="tutorial-item">
              <a href={tutorialHref(t)}>
                <span class="tutorial-row">
                  <span class="tutorial-title">{t.data.title}</span>
                  <span class="tutorial-arrow" aria-hidden="true">→</span>
                </span>
                {t.data.description && <span class="tutorial-desc">{t.data.description}</span>}
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty">
          教程整理中,敬请期待。
          {project.data.repo && (
            <>
              也可以先到<a href={project.data.repo} target="_blank" rel="noopener">仓库 README</a>上手。
            </>
          )}
        </p>
      )
    }

    <p class="back"><a href={projectHref}>← 返回 {project.data.title} 介绍</a></p>
  </section>
</Base>
