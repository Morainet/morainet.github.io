---
// 项目教程列表页(中文,/projects/<slug>/tutorials/)。
import { getProjects, getTutorials } from '../../../../lib/i18n'
import { onlyStandalone } from '../../../../lib/standalone'
import TutorialsView from '../../../../components/views/TutorialsView.astro'

export async function getStaticPaths() {
  const [all, tutorials] = await Promise.all([getProjects('zh'), getTutorials('zh')])
  return onlyStandalone(all).map((project) => ({
    params: { slug: project.id },
    props: {
      project,
      tutorials: tutorials
        .filter((x) => x.id.startsWith(`${project.id}/`))
        .sort((a, b) => a.data.order - b.data.order),
    },
  }))
}

const { project, tutorials } = Astro.props
---
<TutorialsView locale="zh" project={project} tutorials={tutorials} />
