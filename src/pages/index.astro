---
import { getCollection, render } from 'astro:content'
import Base from '../layouts/Base.astro'
import ProjectCard from '../components/ProjectCard.astro'
import ProjectPage from '../components/ProjectPage.astro'
import { MAIN_SITE_URL } from '../config'

const all = await getCollection('projects')
const sorted = [...all].sort((a, b) => a.data.order - b.data.order)
const featured = sorted.filter((p) => p.data.featured)

// 技术方向聚合(标签 + 计数)
const tagCount: Record<string, number> = {}
for (const p of all) {
  for (const t of p.data.tags) tagCount[t] = (tagCount[t] ?? 0) + 1
}
const directions = Object.entries(tagCount).sort((a, b) => b[1] - a[1])
const allTags = [...new Set(all.flatMap((p) => p.data.tags))].sort()

// ── 单项目独立构建模式 ──────────────────────────────────────────
// PROJECT_SLUG=quill npm run build:project 时,首页 / 直接渲染该项目详情页,
// 整个 dist 即一个可部署到任意域名/Vercel 的自包含站点。
const standaloneSlug = process.env.PROJECT_SLUG || ''
let standaloneProject: (typeof all)[number] | undefined
let StandaloneContent: Awaited<ReturnType<typeof render>>['Content'] | undefined
if (standaloneSlug) {
  standaloneProject = all.find((p) => p.id === standaloneSlug)
  if (!standaloneProject) {
    throw new Error(`PROJECT_SLUG="${standaloneSlug}" 没有对应的项目目录(src/content/projects/${standaloneSlug}/)`)
  }
  ;({ Content: StandaloneContent } = await render(standaloneProject))
}

const pageTitle = standaloneProject ? standaloneProject.data.title : undefined
const pageDescription = standaloneProject
  ? standaloneProject.data.description
  : 'Morainet 组织各项目的详细介绍:技术栈、核心特性与项目进展。'
---
<Base title={pageTitle} description={pageDescription}>
  {
    standaloneProject && StandaloneContent ? (
      <ProjectPage project={standaloneProject} all={all} standalone>
        <StandaloneContent />
      </ProjectPage>
    ) : (
      <>
        <section class="hero">
          <h1>Morainet</h1>
          <p class="tagline">项目介绍平台</p>
          <p class="lead">
            集中展示 Morainet 组织内各项目的详细介绍与技术方向。组织整体介绍见
            <a href={MAIN_SITE_URL} target="_blank" rel="noopener">主站</a>。
          </p>
          <a href="#projects" class="btn">浏览项目 ↓</a>
        </section>

        <section class="stats">
          <div class="stat">
            <span class="stat-num">{all.length}</span>
            <span class="stat-label">开源项目</span>
          </div>
          <div class="stat">
            <span class="stat-num">{directions.length}</span>
            <span class="stat-label">技术方向</span>
          </div>
          <div class="stat">
            <span class="stat-num">{featured.length}</span>
            <span class="stat-label">重点推进</span>
          </div>
        </section>

        <section class="section container">
          <h2>技术方向</h2>
          <div class="tag-cloud">
            {directions.map(([tag, count]) => (
              <span class="cloud-chip" title={`${count} 个项目`}>
                {tag}
                <sup>{count}</sup>
              </span>
            ))}
          </div>
        </section>

        <section id="projects" class="section container">
          <h2>全部项目</h2>
          <div class="filters">
            <input class="search" type="search" placeholder="搜索项目…" aria-label="搜索项目" />
            <div class="tag-filters">
              {['全部', ...allTags].map((t) => (
                <button class:list={['chip', { 'chip-active': t === '全部' }]} data-tag={t}>
                  {t}
                </button>
              ))}
            </div>
          </div>

          <div class="grid">
            {sorted.map((p) => (
              <ProjectCard project={p} />
            ))}
          </div>
          <p class="empty" data-filter-empty hidden>没有匹配的项目。</p>
        </section>
      </>
    )
  }
</Base>

{
  !standaloneSlug && (
    <script>
      // 首页项目筛选 + 搜索(纯前端,无框架)
      const search = document.querySelector<HTMLInputElement>('.search')
      const chips = [...document.querySelectorAll<HTMLButtonElement>('.tag-filters .chip')]
      const cards = [...document.querySelectorAll<HTMLElement>('[data-project-card]')]
      const empty = document.querySelector('[data-filter-empty]')
      let activeTag = '全部'

      function applyFilter() {
        const q = (search?.value ?? '').trim().toLowerCase()
        let visible = 0
        for (const card of cards) {
          const okTag = activeTag === '全部' || (card.dataset.tags ?? '').split('|').includes(activeTag)
          const okQuery = q === '' || (card.dataset.text ?? '').toLowerCase().includes(q)
          const show = okTag && okQuery
          card.style.display = show ? '' : 'none'
          if (show) visible++
        }
        empty?.toggleAttribute('hidden', visible > 0)
      }

      search?.addEventListener('input', applyFilter)
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          activeTag = chip.dataset.tag ?? '全部'
          chips.forEach((c) => c.classList.toggle('chip-active', c === chip))
          applyFilter()
        })
      })
    </script>
  )
}
